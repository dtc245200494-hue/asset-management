      "id": 10,
      "title": "Container Memory Usage",
      "type": "timeseries",
      "targets": [
        {
          "expr": "container_memory_usage_bytes{name=~\"asset-.*\"}",
          "legendFormat": "{{name}}"
        }
      ]
    }
